<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.TodoMapper">
	<resultMap id="todoResultMap" type="com.example.demo.Todo">
		<id property="id" column="id"/>
		<result property="title" column="title"/>
		<result property="author" column="author"/>
		<result property="completed" column="completed"/>
		<result property="createdAt" column="created_at"/>
		<result property="deadline" column="deadline"/>
		<result property="priority" column="priority"/>
		<association property="category" javaType="com.example.demo.Category"
						 notNullColumn="category_id">
			<id property="id" column="category_id"/>
			<result property="name" column="category_name"/>
			<result property="color" column="category_color"/>
		</association>
	</resultMap>

	<sql id="todoSelectColumns">
		t.id, t.title, t.author, t.completed, t.created_at, t.priority, t.deadline,
		c.id AS category_id, c.name AS category_name, c.color AS category_color
	</sql>

	<sql id="todoFilters">
		<where>
			<if test="keyword != null and keyword != ''">
				t.title LIKE CONCAT('%', #{keyword}, '%')
			</if>
			<if test="categoryId != null">
				AND t.category_id = #{categoryId}
			</if>
		</where>
	</sql>

	<sql id="todoOrderBy">
		ORDER BY
		<choose>
			<when test="sort == 'title'">t.title</when>
			<when test="sort == 'completed'">t.completed</when>
			<when test="sort == 'priority'">
					CASE t.priority
					WHEN 'HIGH' THEN 1
					WHEN 'MEDIUM' THEN 2
					WHEN 'LOW' THEN 3
					ELSE 2
				END
			</when>
			<when test="sort == 'deadline'">t.deadline</when>
			<otherwise>t.created_at</otherwise>
		</choose>
		<choose>
			<when test="direction == 'asc'">ASC</when>
			<otherwise>DESC</otherwise>
		</choose>,
		t.id ASC
	</sql>

	<select id="findAll" resultMap="todoResultMap">
		SELECT <include refid="todoSelectColumns"/>
		FROM todos t
		LEFT JOIN categories c ON c.id = t.category_id
		<include refid="todoOrderBy"/>
	</select>

	<select id="findPage" resultMap="todoResultMap">
		SELECT <include refid="todoSelectColumns"/>
		FROM todos t
		LEFT JOIN categories c ON c.id = t.category_id
		<include refid="todoFilters"/>
		<include refid="todoOrderBy"/>
		LIMIT #{limit} OFFSET #{offset}
	</select>

	<select id="findForExport" resultMap="todoResultMap">
		SELECT <include refid="todoSelectColumns"/>
		FROM todos t
		LEFT JOIN categories c ON c.id = t.category_id
		<include refid="todoFilters"/>
		<include refid="todoOrderBy"/>
	</select>

	<select id="countFiltered" resultType="long">
		SELECT COUNT(*) FROM todos t
		<include refid="todoFilters"/>
	</select>

	<select id="searchByTitle" resultMap="todoResultMap">
		SELECT <include refid="todoSelectColumns"/>
		FROM todos t
		LEFT JOIN categories c ON c.id = t.category_id
		WHERE t.title LIKE CONCAT('%', #{keyword}, '%')
		<include refid="todoOrderBy"/>
	</select>

	<select id="findById" parameterType="long" resultMap="todoResultMap">
		SELECT <include refid="todoSelectColumns"/>
		FROM todos t
		LEFT JOIN categories c ON c.id = t.category_id
		WHERE t.id = #{id}
	</select>

	<insert id="insert" parameterType="com.example.demo.Todo"
			useGeneratedKeys="true" keyProperty="id">
		INSERT INTO todos (title, author, completed, priority, category_id, deadline)
		VALUES (#{title}, #{author}, #{completed}, #{priority}, #{category.id}, #{deadline})
	</insert>

	<delete id="deleteById" parameterType="long">
		DELETE FROM todos
		WHERE id = #{id}
	</delete>

	<delete id="deleteByIds">
		DELETE FROM todos
		WHERE id IN
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</delete>

	<update id="update" parameterType="com.example.demo.Todo">
		UPDATE todos
		SET title = #{title},
			completed = #{completed},
			priority = #{priority},
			category_id = #{category.id},
			deadline = #{deadline}
		WHERE id = #{id}
	</update>
</mapper>
