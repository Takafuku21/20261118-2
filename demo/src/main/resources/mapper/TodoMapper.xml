<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.TodoMapper">
	<sql id="todoOrderBy">
		ORDER BY
		<choose>
			<when test="sort == 'title'">title</when>
			<when test="sort == 'completed'">completed</when>
			<otherwise>created_at</otherwise>
		</choose>
		<choose>
			<when test="direction == 'asc'">ASC</when>
			<otherwise>DESC</otherwise>
		</choose>,
		id ASC
	</sql>

	<select id="findAll" resultType="com.example.demo.Todo">
		SELECT id, title, completed, created_at
		FROM todos
		<include refid="todoOrderBy"/>
	</select>

	<select id="searchByTitle" resultType="com.example.demo.Todo">
		SELECT id, title, completed, created_at
		FROM todos
		WHERE title LIKE CONCAT('%', #{keyword}, '%')
		<include refid="todoOrderBy"/>
	</select>

	<select id="findById" parameterType="long" resultType="com.example.demo.Todo">
		SELECT id, title, completed, created_at
		FROM todos
		WHERE id = #{id}
	</select>

	<insert id="insert" parameterType="com.example.demo.Todo"
			useGeneratedKeys="true" keyProperty="id">
		INSERT INTO todos (title, completed)
		VALUES (#{title}, #{completed})
	</insert>

	<delete id="deleteById" parameterType="long">
		DELETE FROM todos
		WHERE id = #{id}
	</delete>

	<update id="update" parameterType="com.example.demo.Todo">
		UPDATE todos
		SET title = #{title},
			completed = #{completed}
		WHERE id = #{id}
	</update>
</mapper>
